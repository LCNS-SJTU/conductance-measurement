/* use voltage clamp to measure the local conductance transients with different strengths at one location

/*apical trunk list: 0(41.50)-2(94.47)-14(122.82)-28(151.46)-30(179.70)-32(195.53)-40(201.79)-
	-44(227.96)-52(254.45)-60(262.17)-66(268.27)-72(283.71)-74(311.14)-78(343.59)*/
  
load_file("preload_files.hoc")

cvode.active(0)
dt=0.1

tstop=300      //simulation end time
Loc=74         //input location

//====================declare and initialize variables==========================

objectvar Stim

objref r
r = new Random()

objref vol
objref f_strength
strdef target_path

vol= new Vector()
f_strength = new Vector()
objref savdata, savdataf, recv
recv=new Vector()
recv.record(&soma.v(0))

//=================================functions====================================
access soma
distance()

proc step() {	local i
	fadvance()
		if(ngraph!=0) {
			for i=0, ngraph-1{
				g[i].plot(t)
				g[i].flush()
				doNotify()
			}
		}
}

proc run() { local j
	init()
	if(ngraph!=0) {
		for j=0, ngraph-1{
				g[j].begin()
		}
	}
	while(t<tstop) {
	step()}
}

//======================initialize voltage clamp================================

objref clampobj
soma{
  clampobj = new SEClamp(.5)
  clampobj.dur1=tstop
  clampobj.amp1=-70
  clampobj.rs=1e-3
}

objref irec
irec =new Vector()
irec.record(&clampobj.i)

//===================define main function=======================================

proc main() { 

  savdataf = new File()
	savdataf.wopen("strength.dat")
  
  for trial = 1,30{
  
  f_S= r.uniform(1e-3,1e-2)    //1e-3,1e-2 for active I, 1e-4,5e-3 for active E
  f_strength.append(f_S)
  
  print "trial=",trial
  print "f_S=", f_S
  
  sprint(target_path, "%d%s",trial,"single_dynamical_cond_estimate.dat")  //define the output file name
     
	savdata = new File()
	savdata.wopen(target_path)

  
  //========================set synaptic inputs===================================
  dend[Loc] Stim = new ExpSynn(0.4)
  Stim.onset = 0      //(ms)
  Stim.tau1 = 0.5     //(ms)
  Stim.tau2 = 5       //(ms)
  Stim.gmax = f_S     //(uS)
  Stim.e = 0        //(mV)  
            
  //======================given one input without voltage clamp=================
  
  //dend[E_loc] {print distance(0.4)}   
  
  clampobj.dur1=1
  
  Stim.onset=200
  
  run()
  vol = recv.c.sub(0)
  vol.printf(savdata,"%g \t")
  irec.printf(savdata,"%g \t")
  
  //================given one input, and voltage clamp is used==================
  
  clampobj.dur1=tstop
  
  for k = 1,5{
      clampobj.amp1=-110+k*10

      Stim.onset=200
  
      run()
      vol = recv.c.sub(0)
      vol.printf(savdata,"%g \t")
      irec.printf(savdata,"%g \t")
  
  	}
  
  	savdata.close()
  
  }
    f_strength.printf(savdataf,"%g \t")
    savdataf.close()
  	print "Done!\n"
}
//====================execute the main function=================================


main()
