/* use voltage clamp to measure the local conductance transients at different dendritic locations

/*apical trunk list: 0(41.50)-2(94.47)-14(122.82)-28(151.46)-30(179.70)-32(195.53)-40(201.79)-
	-44(227.96)-52(254.45)-60(262.17)-66(268.27)-72(283.71)-74(311.14)-78(343.59)*/
  
load_file("preload_files.hoc")

cvode.active(0)
dt=0.1

tstop=300      //simulation end time

//====================declare and initialize variables==========================

double Loc[18]   //scan input locations on the apical dendritic trunk
Loc[0] =0
Loc[1] =2
Loc[2] =14
Loc[3] =28
Loc[4] =30
Loc[5] =32
Loc[6] =40
Loc[7] =44
Loc[8] =52
Loc[9] =60
Loc[10] =66
Loc[11] =72
Loc[12] =74
Loc[13] =78
Loc[14] =84
Loc[15] =90
Loc[16] =92
Loc[17] =98

objectvar Stim

objref vol
objref dis
strdef target_path

vol= new Vector()
dis = new Vector()
objref savdata, savdataf, recv
recv=new Vector()
recv.record(&soma.v(0))

//=================================functions====================================
access soma
distance()

proc step() {	local i
	fadvance()
		if(ngraph!=0) {
			for i=0, ngraph-1{
				g[i].plot(t)
				g[i].flush()
				doNotify()
			}
		}
}

proc run() { local j
	init()
	if(ngraph!=0) {
		for j=0, ngraph-1{
				g[j].begin()
		}
	}
	while(t<tstop) {
	step()}
}

//======================initialize voltage clamp================================

objref clampobj
soma{
  clampobj = new SEClamp(.5)
  clampobj.dur1=tstop
  clampobj.amp1=-70
  clampobj.rs=1e-10
}

objref irec
irec =new Vector()
irec.record(&clampobj.i)

//===================define main function=======================================

proc main() { 

savdataf = new File()
savdataf.wopen("distance.dat")

for trial = 0,17{

dend[Loc[trial]]{
dis.append(distance(0.5))

print "trial=",trial  
print distance(0.5)
}

sprint(target_path, "%d%s",trial,"loc_single_dynamical_cond_estimate.dat")  //define the output file name
   
savdata = new File()
savdata.wopen(target_path)

//========================set synaptic inputs===================================
dend[Loc[trial]] {
Stim = new ExpSynn(0.5)
Stim.onset = 0      //(ms)
Stim.tau1 = 0.5     //(ms)
Stim.tau2 = 5       //(ms)
Stim.gmax = 5e-3    //(uS)
Stim.e = 0        //(mV)  
}
          
//========an input is given without voltage clamp=====================

//dend[E_loc] {print distance(0.4)}   

clampobj.dur1=1

Stim.onset=200

run()
vol = recv.c.sub(0)
vol.printf(savdata,"%g \t")
irec.printf(savdata,"%g \t")

//=========an input is given, and voltage clamp is used================

clampobj.dur1=tstop

for k = 1,5{
    clampobj.amp1=-110+k*10

    Stim.onset=200

    run()
    vol = recv.c.sub(0)
    vol.printf(savdata,"%g \t")
    irec.printf(savdata,"%g \t")

	}

	savdata.close()

}
  dis.printf(savdataf,"%g \t")
  savdataf.close()
	print "Done!\n"
}
//====================execute the main function=================================


main()
